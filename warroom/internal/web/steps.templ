package web

import (
	"strconv"
	"strings"
)

func viewClass(side bool) string {
	if side {
		return "v-side"
	}
	return "v-flip"
}

func colsStyle(n int) templ.SafeCSS {
	return templ.SafeCSS("--n:" + strconv.Itoa(n))
}

templ AnswerForm(f FormView) {
	if !isReadOnly(ctx) {
		<form
			id="answer"
			method="post"
			action={ templ.SafeURL(f.Action) }
			hx-post={ f.Action }
			hx-swap="innerHTML show:top"
			hx-sync="this:queue all"
			data-step={ f.Step }
			hidden
		></form>
	}
}

templ PickButton(value, class, key string) {
	if !isReadOnly(ctx) {
		<button
			type="submit"
			form="answer"
			name="pick"
			value={ value }
			class={ class }
			if key != "" {
				data-key={ key }
			}
		>
			{ children... }
		</button>
	}
}

// No Claude's-pick tag here: only the Pick button's tab names it (user, 2026-11-21).
templ Tags(o OptView) {
	if o.Picked {
		<span class="tag got">Picked</span>
	}
	if o.Reveal != "" {
		<span class="tag rv">{ o.Reveal }</span>
	}
}

templ OptBody(o OptView) {
	switch {
		case o.Card != nil:
			<div class="card">
				if o.Card.Title != "" {
					<div class="ct">{ o.Card.Title }</div>
				}
				for _, l := range o.Card.Lines {
					<div class={ "q", templ.KV("hl", l.Hl) }>@Fmt(l.Text)</div>
				}
				if o.Card.Foot != "" {
					<div class="foot">{ o.Card.Foot }</div>
				}
			</div>
		case o.Audio != nil:
			<div class="aud">
				if o.Audio.Missing {
					<span class="missing">[sound missing: { o.Audio.URL }]</span>
				} else {
					<button type="button" class="btn lg" data-play={ o.Audio.Letter } data-audio={ o.Audio.URL }>@Kbd("Space")<span>Play</span></button>
				}
				<span class="lv">{ o.Audio.Level }</span>
			</div>
		case o.Pic != nil:
			@Picture(*o.Pic)
	}
}

templ Act(v ChoiceView) {
	<div class="act">
		if v.Act.Confirm {
			@PickButton("yes", "pick btn", "enter") {
				Yes, as drawn
				@Kbd("Enter")
			}
			@PickButton("change", "btn", "") {
				Change (say what in the note)
			}
		} else if !isReadOnly(ctx) {
			<button type="submit" form="answer" name="pick" value={ v.Act.Shown } data-shown class="pick btn" data-key="enter">
				Pick <span class="pl">{ v.Act.Shown }</span> @Kbd("Enter")
				if v.Act.Cp != "" {
					<span class="tag cp ptab" data-cp={ v.Act.Cp } hidden?={ v.Act.Cp != v.Act.Shown }>Claude's pick</span>
				}
			</button>
		}
		@NeutralAnswer(v.Act.Neutral)
	</div>
}

// The tooltip says what the neutral answer records (user, 2026-11-21: no visible hint line).
const neutralTitle = "Records no winner. Say why in the note."

templ NeutralAnswer(neutral string) {
	if neutral != "" && !isReadOnly(ctx) {
		<button type="submit" form="answer" name="pick" value="neither" class="neutral btn" title={ neutralTitle }>{ neutral }</button>
	}
}

templ LargeButton() {
	<button type="button" class="btn" data-act="large">@Kbd("L") Large</button>
}

// Measures holds what each option's render page reports over wr:measure; warroom.js fills it.
templ Measures(opts []OptView) {
	<div class="measures">
		for _, o := range opts {
			if o.Measure {
				<div class="measure" data-measure={ o.Letter } hidden?={ !o.On }></div>
			}
		}
	</div>
}

templ LabBox(l LabView) {
	<div class="lab">
		if l.Started {
			<iframe class="labframe" src={ l.URL } title="lab" style={ templ.SafeCSS("aspect-ratio:" + strconv.Itoa(l.W) + "/" + strconv.Itoa(l.H)) }></iframe>
		} else {
			<p>@Fmt(l.Hint)</p>
			<a class="pick btn" href={ templ.SafeURL(l.Href) } hx-get={ l.Href } hx-push-url="true" hx-swap="innerMorph" data-keepview>Start the lab here</a>
			<a class="lablink" href={ templ.SafeURL(l.URL) } hx-boost="false">Open the lab in this tab</a>
		}
	</div>
}

templ FlipStage(v ChoiceView) {
	<div class="zone stagecol">
		<div class="stage" data-swipe>
			if v.Lab != nil {
				@LabBox(*v.Lab)
			} else {
				if v.Ref != nil {
					<div class="ostage" data-opt="today" hidden>
						@Picture(v.Ref.Pic)
					</div>
				}
				for _, o := range v.Opts {
					<div class="ostage" data-opt={ o.Letter } hidden?={ !o.On }>
						@OptBody(o)
					</div>
				}
			}
		</div>
	</div>
}

templ Tile(o OptView) {
	<div class={ "tile", templ.KV("sel", o.On), templ.KV("done", o.Done) } data-opt={ o.Letter }>
		<div class="ohd" data-pick={ o.Letter }>
			<span class="let">{ o.Letter }</span>
			<h2>@Fmt(o.Name)</h2>
			@Tags(o)
		</div>
		@OptBody(o)
		if o.Measure {
			<div class="measure" data-measure={ o.Letter }></div>
		}
	</div>
}

templ Tiles(v ChoiceView) {
	<div class="zone stagecol">
		<div class="tiles" style={ colsStyle(v.Cols()) }>
			if v.Ref != nil {
				<div class="tile reft">
					<div class="ohd"><h2>@Fmt(v.Ref.Label)</h2></div>
					@Picture(v.Ref.Pic)
				</div>
			}
			for _, o := range v.Opts {
				@Tile(o)
			}
		</div>
	</div>
}

// StatusLine says how the stage is set; the View menu holds the controls, whose keys work with it closed.
templ StatusLine(v ChoiceView) {
	<div class="status">
		<p class="stxt">
			<span class="sv">
				for i, b := range v.Ctl.StatusItems() {
					if i > 0 {
						{ " · " }
					}
					{ b.Value }
					if b.Name == "fit" {
						<span class="scale"></span>
					}
				}
			</span>
			<span class="vis">
				if len(v.Ctl.StatusItems()) > 0 {
					{ " · " }
				}
				{ v.Ctl.Vision() }
			</span>
		</p>
		if v.ViewHref != "" {
			<a class="btn sm" href={ templ.SafeURL(v.ViewHref) } data-key="w" data-keepview>
				@Kbd("W")
				{ v.ViewLabel }
			</a>
		}
		if v.Large {
			@LargeButton()
		}
		if len(v.Ctl.Buttons) > 0 {
			<details class="viewmenu">
				<summary class="btn sm">View</summary>
				@CtlBar(v.Ctl, false)
			</details>
		}
	</div>
}

// MoreOf draws a block for every option, empty ones too, so the strip's height never depends on the shown option.
templ MoreOf(v ChoiceView) {
	<section class="moreof">
		for _, o := range v.Opts {
			<div data-opt={ o.Letter } hidden?={ !o.On }>
				if len(o.Extras) > 0 {
					<span class="h">More of { o.Letter }</span>
					@Figures(o.Extras)
				}
			</div>
		}
		if !v.Side {
			@Measures(v.Opts)
		}
	</section>
}

templ About(opts []OptView) {
	for _, o := range opts {
		if o.HasAbout() {
			<details class="about" data-opt={ o.Letter } hidden?={ !o.On }>
				<summary>About { o.Letter }</summary>
				if o.Notes != "" {
					<p class="onotes">@Fmt(o.Notes)</p>
				}
				if o.Sees != "" {
					<p class="sees"><span class="h">What you see</span>@Fmt(o.Sees)</p>
				}
				if o.Changes != "" {
					<p class="chg">@Fmt(o.Changes)</p>
				}
				@Folds(o.Folds)
			</details>
		}
	}
}

templ OptRow(o OptView) {
	<button type="button" class={ "orow", templ.KV("sel", o.On) } data-show={ o.Letter } data-key={ o.Key }>
		<span class="ot">
			@Kbd(strings.ToUpper(o.Key))
			if o.Key != strings.ToLower(o.Letter) {
				<b class="fl">{ o.Letter }</b>
			}
			<span class="nm">@Fmt(o.Name)</span>
			@Tags(o)
		</span>
		if o.Notes != "" {
			<span class="onote">@Fmt(o.Notes)</span>
		}
	</button>
}

// Options is the right panel: Today (one at a time only; side by side has its tile) and the option rows, with Pick, the note and the step buttons at one height under them.
templ Options(v ChoiceView) {
	<div class="rpanel">
		<span class="h">Options</span>
		<div class="opts" role="group" aria-label="Options">
			if v.Ref != nil && !v.Side && v.Lab == nil {
				<button type="button" class="orow today" data-show="today" data-key="0">
					<span class="ot">
						@Kbd("0")
						<span class="nm">@Fmt(v.Ref.Label)</span>
					</span>
				</button>
			}
			for _, o := range v.Opts {
				@OptRow(o)
			}
		</div>
		<span class="omore" aria-hidden="true" hidden>▾ more</span>
		@Act(v)
		@NoteBox(v.Note)
		@StepNav(v.Nav)
	</div>
}

// LeftPanel is the chips, the question and its folds.
templ LeftPanel(chips []Chip, h HeadView, i InfoView) {
	<div class="lpanel">
		@ChipNav(chips)
		@Head(h, i)
	</div>
}

// RightPanel holds every kind's answer controls with the step buttons under them, where a choice step has Pick.
templ RightPanel(nav NavView) {
	<div class="rpanel">
		{ children... }
		@StepNav(nav)
	</div>
}

templ ChoiceMain(v ChoiceView, chips []Chip) {
	<main id="main" class={ "step", "choice", "k-" + v.Kind, viewClass(v.Side) }>
		<div class="lpanel">
			@ChipNav(chips)
			@Head(v.Head, v.Info) {
				@About(v.Opts)
			}
		</div>
		<div class="cpanel">
			if v.Side {
				@Tiles(v)
			} else {
				@FlipStage(v)
			}
			@StatusLine(v)
			@MoreOf(v)
		</div>
		@Options(v)
	</main>
	@AnswerForm(v.Form)
}

templ VerdictBox(v VerdictView) {
	if !isReadOnly(ctx) {
		<section class="verdict">
			for _, b := range v.Buttons {
				<button
					type="submit"
					form="answer"
					name="pick"
					value={ b.Value }
					class={ "vb btn lg", templ.KV("pick", b.Value == "pass"), templ.KV("done", b.Done) }
					if b.Value == "pass" {
						data-key="enter"
					}
				>
					{ b.Label }
					if b.Value == "pass" {
						@Kbd("Enter")
					}
				</button>
			}
			@NoteField(v.Note)
		</section>
	}
}

templ GalleryMain(v GalleryView, chips []Chip) {
	<main id="main" class="step k-gallery">
		@LeftPanel(chips, v.Head, v.Info)
		<div class="cpanel">
			if v.Empty {
				<p class="missing">[gallery has no items]</p>
			} else {
				<section class="stagecol">
					@CtlBar(v.Ctl, false)
					<div class="stage gmain" data-swipe>
						@Picture(v.Main)
					</div>
					<div class="tools">
						<span class="scale"></span>
						@LargeButton()
					</div>
				</section>
				<section class="thumbs">
					for _, t := range v.Thumbs {
						<a class={ "th", templ.KV("on", t.On), templ.KV("noted", t.Noted) } href={ templ.SafeURL(t.Href) }>
							@Picture(t.Pic)
							<span>{ t.Label }</span>
						</a>
					}
				</section>
			}
		</div>
		@RightPanel(v.Nav) {
			if !v.Empty {
				<section class="gside">
					<span class="cnt">{ v.Count }</span>
					<h2>{ v.ItemLabel }</h2>
					<p>@Fmt(v.Caption)</p>
					if !isReadOnly(ctx) {
						<label for={ v.ItemNote.ID } class="h">{ v.ItemNote.Label }</label>
						@NoteField(v.ItemNote)
					}
					<div class="inav">
						<a class="btn sm" href={ templ.SafeURL(v.PrevHref) } data-key="p">@Kbd("P") Previous</a>
						<a class="btn sm" href={ templ.SafeURL(v.NextHref) } data-key="n">Next @Kbd("N")</a>
					</div>
				</section>
			}
			if v.Verdict != nil {
				@VerdictBox(*v.Verdict)
			}
		}
	</main>
	@AnswerForm(v.Form)
}

templ VerdictMain(v VerdictStepView, chips []Chip) {
	<main id="main" class="step k-verdict">
		@LeftPanel(chips, v.Head, v.Info)
		<div class="cpanel"></div>
		@RightPanel(v.Nav) {
			@VerdictBox(v.Verdict)
		}
	</main>
	@AnswerForm(v.Form)
}

templ TuneMain(v TuneView, chips []Chip) {
	<main id="main" class="step k-tune">
		@LeftPanel(chips, v.Head, v.Info)
		<div class="cpanel">
			<section class="stagecol">
				<div class="stage">
					@Picture(v.Pic)
				</div>
				<wr-tune data-params={ v.Params } data-target={ v.Pic.FrameID } data-field={ tuneField }></wr-tune>
			</section>
		</div>
		@RightPanel(v.Nav) {
			<div class="act">
				@PickButton("tuned", "pick btn", "enter") {
					Use these values
					@Kbd("Enter")
				}
				@NeutralAnswer(v.Neutral)
			</div>
			@NoteBox(v.Note)
		}
	</main>
	<input type="hidden" id={ tuneField } name="value" form="answer" value={ v.Value }/>
	@AnswerForm(v.Form)
}

templ WordingMain(v WordingView, chips []Chip) {
	<main id="main" class="step k-wording">
		@LeftPanel(chips, v.Head, v.Info)
		<div class="cpanel">
			<section class="fields">
				if !isReadOnly(ctx) {
					<p class="nhint">Edits are recorded as you type.</p>
				}
				for _, f := range v.Fields {
					<div class="field">
						<label for={ f.Note.ID } class="h">{ f.Note.Label }</label>
						if !isReadOnly(ctx) {
							@NoteField(f.Note)
						}
						if f.Was != "" {
							<p class="was">Drafted: @Fmt(f.Was)</p>
						}
					</div>
				}
			</section>
		</div>
		@RightPanel(v.Nav) {
			if !isReadOnly(ctx) {
				<div class="act">
					<a class="pick btn" href={ templ.SafeURL(v.Nav.Next) } data-key="enter">Done, next @Kbd("Enter")</a>
				</div>
			}
		}
	</main>
}

templ MissingMain(v MissingView, chips []Chip) {
	<main id="main" class="step k-missing">
		<div class="lpanel">
			@ChipNav(chips)
			<section class="head">
				<span class="n" title={ v.Eyebrow }>{ v.Eyebrow }</span>
				<h1>[step missing: { v.Key }]</h1>
			</section>
		</div>
		<div class="cpanel">
			<p class="missing">{ v.Path } did not load.</p>
		</div>
		@RightPanel(v.Nav)
	</main>
}

templ SumTable(rows []SumRow) {
	if len(rows) == 0 {
		<p>Nothing recorded yet.</p>
	} else if isReadOnly(ctx) {
		<div class="scroll">
			<table class="sum">
				<thead>
					<tr><th>Question</th></tr>
				</thead>
				<tbody>
					for _, r := range rows {
						<tr><td>@Fmt(r.Label)</td></tr>
					}
				</tbody>
			</table>
		</div>
	} else {
		<div class="scroll">
			<table class="sum">
				<thead>
					<tr><th>Question</th><th>Pick</th><th>Note</th></tr>
				</thead>
				<tbody>
					for _, r := range rows {
						<tr>
							<td>@Fmt(r.Label)</td>
							<td>
								@Fmt(r.Pick)
								if r.Changes > 1 {
									<small class="times">changed { strconv.Itoa(r.Changes) } times</small>
								}
							</td>
							<td>{ r.Note }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ SummaryMain(v SummaryView, nav NavView, chips []Chip) {
	<main id="main" class="step k-summary">
		<div class="lpanel">
			@ChipNav(chips)
			<section class="head">
				<span class="n" title={ v.Eyebrow }>{ v.Eyebrow }</span>
				<h1>{ v.Title }</h1>
			</section>
		</div>
		<div class="cpanel">
			<div id="sum" class="sumblock">
				@Intro(v.Intro, true)
				<h2>{ v.Main.Title } <span class="cnt">{ v.Main.Count }</span></h2>
				@SumTable(v.Main.Rows)
				if len(v.Open) > 0 {
					<p class="close">
						<span class="h">Not answered yet</span>
						<span class="opens">
							for _, l := range v.Open {
								<a class="btn" href={ templ.SafeURL(l.Href) }>{ l.Label }</a>
							}
						</span>
					</p>
				} else if !isReadOnly(ctx) {
					<p class="close">You can close this tab.</p>
				}
				<pre id="summary-text" hidden>{ v.Text }</pre>
			</div>
			if len(v.Earlier) > 0 {
				<div class="sumblock earlier">
					<h3 class="sec">Earlier rounds</h3>
					for _, e := range v.Earlier {
						<h2>{ e.Title } <span class="cnt">{ e.Count }</span></h2>
						@SumTable(e.Rows)
					}
				</div>
			}
		</div>
		@RightPanel(nav) {
			<p class="copy">
				<button type="button" class="btn" data-copy-from="#summary-text">Copy summary</button>
				<span class="copied" aria-live="polite"></span>
			</p>
		}
	</main>
}

templ RoundListMain(links []RoundLink) {
	<main id="main" class="step k-index">
		<section class="head">
			<span class="n">War Room</span>
			<h1>Rounds</h1>
		</section>
		<ul class="rounds">
			for _, l := range links {
				<li>
					<a href={ templ.SafeURL(l.Href) }>
						{ l.Title }
						if l.Note != "" {
							<span class="adv">{ l.Note }</span>
						}
					</a>
				</li>
			}
		</ul>
	</main>
}
