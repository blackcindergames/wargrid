{
	"name": "warroom-islands",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build && cp node_modules/htmx.org/dist/htmx.min.js ../internal/web/static/htmx.min.js",
		"format": "prettier --config .prettierrc.json --write . ../internal/web/static/warroom.js",
		"format:check": "prettier --config .prettierrc.json --check . ../internal/web/static/warroom.js",
		"lint": "cd .. && islands/node_modules/.bin/eslint -c islands/eslint.config.js --max-warnings 0 islands internal/web/static/warroom.js",
		"lint:fix": "npm run lint -- --fix",
		"check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"quality": "npm run format:check && npm run lint && npm run check"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tweakpane/core": "2.0.5",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"htmx.org": "4.0.1",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tweakpane": "4.0.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"vite": "8.3.8"
	}
}
