{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": [],
		"paths": { "htmx.org": ["./node_modules/htmx.org/dist/htmx.d.ts"] },
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"allowJs": true,
		"checkJs": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["*.ts", "*.js", "*.svelte", "../internal/web/static/warroom.js"]
}
