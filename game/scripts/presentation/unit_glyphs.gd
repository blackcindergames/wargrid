# One glyph per body role, shared by the factions; a role missing here shows its name only.
const ROLES := {&"tank_usa": &"tank", &"tank_frc": &"tank", &"tank_china": &"tank", &"tank_china_gatling": &"rotary", &"infantry": &"rifle", &"rocket_infantry": &"rocket", &"collector_truck": &"truck", &"bulldozer": &"dozer"}
# The draft's glyph grey (factory.html `--glyph`); owner colour stays for state.
const COLOUR := "#bacbd5"
# Rasterised at 96 px with mipmaps, so it stays sharp from a 19 px cell to a 2x canvas.
const SCALE: float = 2.0

static var _cache: Dictionary = {}

static func texture(kind: String) -> Texture2D:
	var glyph: StringName = ROLES.get(Shapes.role(kind), &"")
	if glyph.is_empty(): return null
	if not _cache.has(glyph): _cache[glyph] = _raster(PATHS[glyph])
	return _cache[glyph]

static func _raster(paths: Array) -> Texture2D:
	var svg: String = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="48" height="48" fill="%s"><path opacity=".4" d="%s"/><path d="%s"/></svg>' % [COLOUR, paths[0], paths[1]]
	var image := Image.new()
	var error: Error = image.load_svg_from_string(svg, SCALE)
	assert(error == OK, "glyph svg failed to load")
	image.generate_mipmaps()
	return ImageTexture.create_from_image(image)
